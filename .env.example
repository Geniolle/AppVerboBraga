# AppVerboBraga Environment Configuration
# Copy this file to .env.production and fill in actual values for production deployment

# ========================================
# ENVIRONMENT MODE
# ========================================

# Set to "true" for production (forces APP_SECRET_KEY validation)
PRODUCTION=false

# ========================================
# DATABASE
# ========================================

# PostgreSQL connection details
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/app_igreja

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_igreja

# Connection pool settings (PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=1

# ========================================
# SECURITY
# ========================================

# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be set in production; auto-generated in development
# Changing this invalidates all sessions/tokens
APP_SECRET_KEY=change-me-immediately-in-production

# Public URL for the application (used for OAuth redirects, email links, webhooks)
# MUST match actual domain in production
# Examples: https://verbodavidabraga.pt | http://localhost:8000 (dev)
APP_PUBLIC_URL=https://verbodavidabraga.pt

# ========================================
# ADMIN USER (Bootstrap)
# ========================================

# Initial admin user email
ADMIN_LOGIN_EMAIL=admin@verbodavidabraga.pt

# Initial admin password (optional, generates random if empty)
ADMIN_LOGIN_PASSWORD=

# Comma-separated admin profile names
ADMIN_PROFILE_NAMES=admin,administrador

# Superuser profile name
ENTITY_SUPERUSER_PROFILE_NAME=SUPER USER

# ========================================
# OAUTH (Optional - leave empty to disable)
# ========================================

# Google OAuth - Configure at https://console.cloud.google.com
# Redirect URI: https://verbodavidabraga.pt/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth - Configure at https://portal.azure.com
# Redirect URI: https://verbodavidabraga.pt/oauth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub OAuth - Configure at https://github.com/settings/developers
# Redirect URI: https://verbodavidabraga.pt/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========================================
# WHATSAPP CLOUD API (Optional)
# ========================================

WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ========================================
# EMAIL / SMTP (Optional)
# ========================================

# SMTP server for sending emails (e.g., notifications, invites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@verbodavidabraga.pt
SMTP_FROM_NAME=Verbo da Vida Braga
SMTP_USE_TLS=true

# User invite link TTL (hours)
USER_INVITE_TTL_HOURS=72

# ========================================
# AI / OPENAI (Optional)
# ========================================

OPENAI_API_KEY=

# ========================================
# GOOGLE DRIVE (Optional)
# ========================================

# Google Drive integration for MT940 file imports
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# ========================================
# PROFILE AND ENTITY CONFIGURATION
# ========================================

# Entity profile scope constants (do not change)
ENTITY_PROFILE_SCOPE_OWNER=owner
ENTITY_PROFILE_SCOPE_LEGADO=legado

# Entity numbering range
ENTITY_NUMBER_MIN=1000
ENTITY_NUMBER_MAX=9999

# ========================================
# LEGACY FEATURES
# ========================================

# Allow legacy users to view owner entity additional fields
LEGACY_CAN_VIEW_OWNER_PROCESS_ADDITIONAL_FIELDS=false
