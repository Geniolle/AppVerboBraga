# ========================================
# DATABASE
# ========================================

# PostgreSQL connection details
# Required for production
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/app_igreja

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_igreja

# Connection pool settings (optional, adjust for your load)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=1

# ========================================
# SECURITY
# ========================================

# CRITICAL: APP_SECRET_KEY must be set and persistent in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DO NOT commit this to version control
# Changing this value will invalidate all existing sessions/tokens
APP_SECRET_KEY=generate-a-random-secret-key

# Public URL for the application (used for OAuth redirects, email links, etc.)
# MUST be set to the actual domain in production
# Example: https://appverbo.example.com
APP_PUBLIC_URL=http://127.0.0.1:8000

# ========================================
# ADMIN USER
# ========================================

# Bootstrap admin user email
ADMIN_LOGIN_EMAIL=admin@appverbo.local

# Bootstrap admin password (optional, if empty will be randomly generated)
ADMIN_LOGIN_PASSWORD=

# Comma-separated list of profile names that have admin capabilities
ADMIN_PROFILE_NAMES=admin,administrador

# Entity superuser profile name (optional)
ENTITY_SUPERUSER_PROFILE_NAME=SUPER USER

# ========================================
# OAUTH (Optional - leave empty to disable)
# ========================================

# Google OAuth
# Register at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
# Register at: https://portal.azure.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub OAuth
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========================================
# WHATSAPP CLOUD API (Optional)
# ========================================

WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ========================================
# SMTP / EMAIL (Optional - leave empty to disable)
# ========================================

# SMTP server for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AppVerboBraga
SMTP_USE_TLS=true

# User invite link TTL (hours)
USER_INVITE_TTL_HOURS=72

# ========================================
# OPENAI / AI FEATURES (Optional)
# ========================================

OPENAI_API_KEY=sk-...

# Song transcription features
SONGS_TRANSCRIPTION_ENABLED=true
SONGS_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SONGS_LYRICS_FORMATTING_MODEL=gpt-4.1-mini
SONGS_TRANSCRIPTION_LANGUAGE=pt
SONGS_TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=180
SONGS_TRANSCRIPTION_DOWNLOAD_TIMEOUT_SECONDS=180

# ========================================
# GOOGLE DRIVE (Optional)
# ========================================

# Google Service Account JSON path or content
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Google Drive folder ID for MT940 imports
GOOGLE_DRIVE_MT940_FOLDER_ID=1eC7L09HlSjfMUT8vrNM-lekNLX-0FGlN

# Backup folder name in Google Drive
GOOGLE_DRIVE_MT940_BACKUP_FOLDER_NAME=Backup MT940

# Menu key for MT940 import
MT940_IMPORT_MENU_KEY=extrato

# ========================================
# PROFILE ENTITY SCOPE (do not change)
# ========================================

# Entity profile scope constants
ENTITY_PROFILE_SCOPE_OWNER=owner
ENTITY_PROFILE_SCOPE_LEGADO=legado

# ========================================
# ENTITY NUMBERING
# ========================================

ENTITY_NUMBER_MIN=1000
ENTITY_NUMBER_MAX=9999

# ========================================
# LEGACY FEATURES
# ========================================

# Allow legacy scope to view owner additional fields
LEGACY_CAN_VIEW_OWNER_PROCESS_ADDITIONAL_FIELDS=false
